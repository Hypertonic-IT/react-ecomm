# Backend Production Environment Variables
# Copy this file to .env and update with your actual production values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB Atlas connection string (recommended)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/hypertonic_ecommerce?retryWrites=true&w=majority

# Database name
DB_NAME=hypertonic_ecommerce

# ==========================================
# SERVER CONFIGURATION
# ==========================================
# Port (cPanel usually uses 3001 or assigns automatically)
PORT=3001

# Node environment
NODE_ENV=production

# ==========================================
# JWT CONFIGURATION
# ==========================================
# JWT Secret (use a strong random string - generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters_long

# JWT expiration time
JWT_EXPIRE=7d

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Email service (Gmail, SendGrid, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Email credentials (use app-specific password for Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Email from address
EMAIL_FROM=noreply@yourdomain.com

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# Your frontend URL (used for CORS and email links)
FRONTEND_URL=https://yourdomain.com

# CORS allowed origins (can be comma-separated for multiple)
CORS_ORIGIN=https://yourdomain.com

# ==========================================
# PAYMENT GATEWAY (if applicable)
# ==========================================
# Razorpay / Stripe keys
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
# Max file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# Upload directory
UPLOAD_DIR=./uploads

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# Rate limiting (requests per 15 minutes)
RATE_LIMIT=100

# Session secret
SESSION_SECRET=your_session_secret_key_here

# ==========================================
# OPTIONAL: THIRD-PARTY SERVICES
# ==========================================
# Google OAuth (if using)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# SMS Service (if using)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=your_twilio_phone

# ==========================================
# NOTES
# ==========================================
# 1. Never commit this file to Git
# 2. Keep backups in a secure location
# 3. Use strong, unique values for all secrets
# 4. For Gmail, use app-specific passwords: https://support.google.com/accounts/answer/185833
# 5. Generate strong secrets: openssl rand -base64 32
